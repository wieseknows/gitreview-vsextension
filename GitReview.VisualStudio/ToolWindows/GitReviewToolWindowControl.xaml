<UserControl x:Class="GitReview.VisualStudio.ToolWindows.GitReviewToolWindowControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             MinWidth="320" MinHeight="400" Foreground="White">

    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <!-- Mode -->
            <RowDefinition Height="Auto"/>
            <!-- AI Config -->
            <RowDefinition Height="Auto"/>
            <!-- Scope -->
            <RowDefinition Height="Auto"/>
            <!-- Button -->
            <RowDefinition Height="*"/>
            <!-- Log Output -->
        </Grid.RowDefinitions>

        <!-- 1. Mode Selection -->
        <StackPanel Grid.Row="0" Margin="0,0,0,10">
            <TextBlock Text="Execution Mode" FontWeight="Bold" Margin="0,0,0,4" Foreground="White"/>
            <ComboBox x:Name="ModeComboBox" 
              Height="28" 
              DisplayMemberPath="Title" 
              SelectedValuePath="Value" 
              SelectionChanged="ModeComboBox_SelectionChanged"/>
        </StackPanel>

        <!-- 2. Dynamic AI Panel -->
        <StackPanel x:Name="AiConfigurationPanel" Grid.Row="1" Margin="0,0,0,10">
            <Grid Margin="0,0,0,4">
                <TextBlock Text="Provider" FontWeight="Bold" VerticalAlignment="Center" Foreground="White"/>
                <Button x:Name="OpenSettingsButton" 
                        Content="⚙️ Set API Keys" 
                        HorizontalAlignment="Right" 
                        Padding="8,2" 
                        FontSize="11"
                        Click="OpenSettingsButton_Click"/>
            </Grid>

            <ComboBox x:Name="ProviderComboBox" 
              Height="28" 
              DisplayMemberPath="Title" 
              SelectedValuePath="Value" 
              SelectionChanged="ProviderComboBox_SelectionChanged"/>

            <TextBlock Text="Model" FontWeight="Bold" Margin="0,8,0,4" Foreground="White"/>
            <ComboBox x:Name="ModelComboBox" Height="28" IsEditable="True"/>
        </StackPanel>

        <!-- 3. Scope Selection -->
        <StackPanel Grid.Row="2" Margin="0,0,0,12">
            <TextBlock Text="Git Scope" FontWeight="Bold" Margin="0,0,0,4" Foreground="White"/>
            <ComboBox x:Name="ScopeComboBox" Height="28" SelectedIndex="0">
                <ComboBoxItem Content="Working Changes (Unstaged + Staged)"/>
                <ComboBoxItem Content="Staged Changes Only"/>
                <ComboBoxItem Content="Current Branch vs Main"/>
            </ComboBox>
        </StackPanel>

        <!-- 4. Action Button -->
        <Button x:Name="ReviewButton" 
                Grid.Row="3" 
                Content="Run" 
                Height="32" 
                FontWeight="SemiBold" 
                Margin="0,0,0,12" 
                Click="ReviewButton_Click"/>

        <!-- 5. Output Console Log -->
        <Grid Grid.Row="4">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <TextBlock Grid.Row="0" Text="Execution Log" FontSize="14" FontWeight="Bold" Margin="0,0,0,6" Foreground="White"/>

            <TextBox Grid.Row="1" 
                     x:Name="LogTextBox"
                     IsReadOnly="True"
                     TextWrapping="Wrap"
                     VerticalScrollBarVisibility="Auto"
                     HorizontalScrollBarVisibility="Auto"
                     FontFamily="Consolas"
                     FontSize="12"
                     Background="#1E1E1E"
                     Foreground="#D4D4D4"
                     BorderBrush="#3F3F46"
                     Padding="6"/>
        </Grid>
    </Grid>
</UserControl>